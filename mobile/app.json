{
  "expo": {
    "name": "OfflinePay",
    "slug": "offline-pay",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "offlinepay",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.offlinepay.app",
      "allowBackup": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPreviewNetwork.js",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow OfflinePay to use biometrics to authorize offline payments."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OfflinePay to scan payment QR codes.",
          "barcodeScannerEnabled": false
        }
      ],
      "expo-web-browser",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e454483-e532-4d5a-b9f3-b93e79138ea5"
      }
    },
    "owner": "thanmaydr0"
  }
}
