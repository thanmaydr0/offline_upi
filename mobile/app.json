{
  "expo": {
    "name": "OfflinePay",
    "slug": "offline-pay",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "offlinepay",
    "userInterfaceStyle": "automatic",
    "android": { "package": "com.offlinepay.app" },
    "web": { "output": "server" },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "Allow OfflinePay to use biometrics to authorize offline payments." }],
      ["expo-camera", { "cameraPermission": "Allow OfflinePay to scan payment QR codes." }],
      "expo-web-browser",
      ["expo-sqlite", { "useSQLCipher": true }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
