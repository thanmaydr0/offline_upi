PORT=3000
# Set to 1 behind Render's reverse proxy; leave 0 for direct local access.
TRUST_PROXY_HOPS=0
DB_PATH=./offline-pay.sqlite
JWT_SECRET=replace_with_at_least_32_characters_of_randomness
CHAIN_MODE=fake
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
# Required for custom/mainnet vaults; bundled Base Sepolia demo metadata is automatic.
# CHAIN_DEPLOYMENT_BLOCK=
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
USDC_ADDRESS=0x0000000000000000000000000000000000000000
# Generate local keys with `npm run keys:generate -w backend`; use P1's deployed keys for CHAIN_MODE=chain.
ISSUER_PRIVATE_KEY=replace_with_generated_issuer_private_key
RELAYER_PRIVATE_KEY=replace_with_generated_relayer_private_key
FIAT_GATEWAY=onramp
# Partner dashboard App ID. Live credentials require Onramp KYB and activation.
ONRAMP_APP_ID=2621907
# Keep secrets in ignored .env only. Never put these in EXPO_PUBLIC_* variables.
# ONRAMP_API_KEY=
# ONRAMP_API_SECRET=
# Set these from Onramp's approved USDC/network config, not the EVM chain ID.
# ONRAMP_NETWORK=
# ONRAMP_CHAIN_ID=
# ONRAMP_COIN_ID=
# Live collection also requires CHAIN_MODE=chain, mainnet RPC/CHAIN_ID,
# a deployed mainnet vault, native USDC, relayer gas, and correct vault roles.
# Mock mode is retained solely for automated tests; opt in explicitly if needed.
FIAT_WEBHOOK_SECRET=replace_with_random_secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_a_password_of_at_least_12_chars
INR_PER_USDC=90
MAX_OFFLINE_BALANCE_PAISE=500000
MAX_SINGLE_OFFLINE_PAYMENT_PAISE=200000
MAX_OFFLINE_SPEND_24H_PAISE=500000
VOUCHER_TTL_SECONDS=604800
PAYMENT_DEADLINE_SECONDS=604800
MERCHANT_MAX_UNSETTLED_PAISE=1000000
CLOCK_SKEW_SECONDS=300
WITHDRAW_DELAY_SECONDS=604800
